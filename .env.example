# ─────────────────────────────────────────────────────────────
# Gnevo CRM — environment template.
# Copy this file to `.env` (in the repo root) and fill in values.
# The API validates these at boot (Zod) and refuses to start if invalid.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (PostgreSQL 16/17) — REQUIRED ──
# Local Postgres, or a free cloud DB (Neon: https://neon.tech).
# Neon example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://gnevo:gnevo@localhost:5432/gnevo?schema=public
# Optional read-replica (falls back to DATABASE_URL if left blank)
DATABASE_REPLICA_URL=

# ── Auth secrets — REQUIRED ──
# Generate strong random values:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900        # access-token lifetime, seconds (15m)
JWT_REFRESH_TTL=2592000   # refresh-token lifetime, seconds (30d)

# ── App URLs — REQUIRED ──
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# ── Passkeys / WebAuthn ──
# RP_ID = the site domain (no protocol/port). Use "localhost" in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Redis (BullMQ queues: automations, webhooks, scheduled jobs) ──
# Only the workers app needs this. Free cloud option: Upstash (https://upstash.com).
# Leave blank to run api+web only (pnpm dev:core) without background jobs.
REDIS_URL=redis://localhost:6379

# ── Email / SMTP (invites, magic link, password reset, scheduled reports) ──
# Leave SMTP_HOST blank to DISABLE email — dev links are logged to the API console.
#   Mailtrap sandbox: host=sandbox.smtp.mailtrap.io port=2525 user/pass from Mailtrap
#   Gmail (needs App Password): host=smtp.gmail.com port=587 user=you@gmail.com pass=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gnevo.local

# ── AI providers (optional) ──
# Chat / summaries / insights use the FIRST key present (Groq is free & first).
# RAG semantic search (/search) needs an EMBEDDING key: OpenAI or Google AI only.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ── Google Search Console integration (optional) ──
# OAuth client from Google Cloud Console. Authorised redirect URI:
#   ${API_URL}/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (optional — invoice checkout; test mode is free) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
