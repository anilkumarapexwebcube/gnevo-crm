{
  "name": "gnevo-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:core": "turbo run dev --filter=@gnevo/api --filter=@gnevo/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @gnevo/db migrate:dev",
    "db:generate": "pnpm --filter @gnevo/db generate",
    "db:seed": "pnpm --filter @gnevo/db seed",
    "db:studio": "pnpm --filter @gnevo/db studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@gnevo/config": "workspace:*",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
