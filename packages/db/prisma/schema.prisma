// Gnevo CRM — Prisma schema (canonical source of truth for the data model).
// Multi-tenancy: every tenant-scoped table carries `organizationId`, enforced by
// the tenant middleware (src/client.ts) AND Postgres Row-Level Security (see the
// RLS migration). See docs/05-database-design.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), citext, pgcrypto]
}

// ─────────────────────────── Identity & tenancy ───────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique @db.Citext
  plan      String   @default("trial")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  offices     Office[]
  departments Department[]
  teams       Team[]
  users       User[]
  roles       Role[]
  leads          Lead[]
  customers      Customer[]
  contacts       Contact[]
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  deals          Deal[]
  projects       Project[]
  tasks          Task[]
  automations    Automation[]
  automationRuns AutomationRun[]
  invoices       Invoice[]
  invoiceLines   InvoiceLine[]
  seoProjects    SeoProject[]
  keywords       Keyword[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  articles       Article[]
  announcements  Announcement[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  activities     Activity[]
  fileAssets     FileAsset[]
  passkeys       Passkey[]
  keywordSnapshots KeywordSnapshot[]
  notes          Note[]
  apiKeys        ApiKey[]
  timeEntries    TimeEntry[]
  milestones     Milestone[]
  competitors    Competitor[]
  contentItems   ContentItem[]
  webhooks       WebhookEndpoint[]
  macros         Macro[]
  chatChannels   ChatChannel[]
  chatMembers    ChatChannelMember[]
  chatMessages   ChatMessage[]
  calendarEvents    CalendarEvent[]
  calendarAttendees CalendarAttendee[]
  embeddings        Embedding[]
  clientSnapshots   ClientSnapshot[]
  invitations       Invitation[]
  attendance        Attendance[]
  leaveRequests     LeaveRequest[]
  holidays          Holiday[]

  @@map("organizations")
}

model Office {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]

  @@index([organizationId])
  @@map("offices")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  officeId       String?  @map("office_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office       Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  teams        Team[]
  users        User[]

  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members      TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  fullName       String    @map("full_name")
  passwordHash   String?   @map("password_hash")
  status         String    @default("active")
  departmentId   String?   @map("department_id") @db.Uuid
  officeId       String?   @map("office_id") @db.Uuid
  designation    String?
  employeeId     String?   @map("employee_id")
  joiningDate    DateTime? @map("joining_date") @db.Date
  reportingManagerId String? @map("reporting_manager_id") @db.Uuid
  avatarData     Bytes?    @map("avatar_data")
  avatarType     String?   @map("avatar_type")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")
  lastActiveAt   DateTime? @map("last_active_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office       Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles          UserRole[]
  teams          TeamMember[]
  sessions       Session[]
  notifications  Notification[]
  passkeys       Passkey[]
  ownedLeads     Lead[]       @relation("LeadOwner")
  ownedCustomers Customer[]   @relation("CustomerOwner")
  ownedDeals     Deal[]       @relation("DealOwner")
  ownedProjects   Project[]       @relation("ProjectOwner")
  assignedTasks   Task[]          @relation("TaskAssignee")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  ticketMessages  TicketMessage[] @relation("TicketMessageAuthor")
  announcements   Announcement[]  @relation("AnnouncementAuthor")
  chatMemberships ChatChannelMember[]
  eventAttendances CalendarAttendee[]
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

// ─────────────────────────── RBAC ───────────────────────────

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid // null = system role template
  key            String
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  scope        String @default("org")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────── Sessions / devices ───────────────────────────

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ip               String?
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────── CRM core (Lead as first vertical) ───────────────────────────

model Lead {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  email          String?   @db.Citext
  phone          String?
  company        String?
  status         String    @default("new")
  source         String    @default("manual")
  score          Int?
  ownerId        String?   @map("owner_id") @db.Uuid
  tags           String[]  @default([])
  custom         Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("leads")
}

model Customer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  type           String    @default("company")
  status         String    @default("active")
  industry       String?
  website        String?
  ownerId        String?   @map("owner_id") @db.Uuid
  accountManagerId String? @map("account_manager_id") @db.Uuid
  tags           String[]  @default([])
  custom         Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  projects     Project[]
  invoices     Invoice[]
  tickets      Ticket[]
  snapshots    ClientSnapshot[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("customers")
}

model Ticket {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  subject        String
  description    String
  status         String    @default("open")
  priority       String    @default("medium")
  assigneeId     String?   @map("assignee_id") @db.Uuid
  portalVisible  Boolean   @default(true) @map("portal_visible")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([organizationId, status])
  @@map("tickets")
}

model TicketMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?        @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId])
  @@map("ticket_messages")
}

model Article {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String
  body           String
  category       String?
  keywords       String?
  published      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("articles")
}

model Announcement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  authorId       String?   @map("author_id") @db.Uuid
  title          String
  body           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("announcements")
}

model Invoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  number          String
  status          String    @default("draft")
  currency        String    @default("USD")
  notes           String?
  dueDate         DateTime? @map("due_date") @db.Date
  portalVisible   Boolean   @default(true) @map("portal_visible")
  stripeSessionId String?   @map("stripe_session_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @map("unit_price") @db.Decimal(18, 4)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@map("invoice_lines")
}

model Project {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  name           String
  description    String?
  status         String    @default("active")
  ownerId        String?   @map("owner_id") @db.Uuid
  aiSummary      String?   @map("ai_summary")
  portalVisible  Boolean   @default(true) @map("portal_visible")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks        Task[]
  milestones   Milestone[]

  @@index([organizationId, status])
  @@map("projects")
}

model Milestone {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  title          String
  dueDate        DateTime? @map("due_date") @db.Date
  status         String    @default("open")
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@map("milestones")
}

model Task {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  title          String
  status         String    @default("todo")
  priority       String    @default("medium")
  assigneeId     String?   @map("assignee_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  blockedBy      String[]  @default([]) @map("blocked_by") @db.Uuid
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent       Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("Subtasks")

  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId])
  @@map("tasks")
}

model Pipeline {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([organizationId, pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  stageId        String    @map("stage_id") @db.Uuid
  title          String
  value          Decimal   @default(0) @db.Decimal(18, 4)
  currency       String    @default("USD")
  status         String    @default("open")
  probability    Int?
  ownerId        String?   @map("owner_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  expectedClose  DateTime? @map("expected_close") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  owner        User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, ownerId])
  @@map("deals")
}

model Contact {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  name           String
  email          String?   @db.Citext
  phone          String?
  title          String?
  isPrimary      Boolean   @default(false) @map("is_primary")
  // Client-portal login (a contact is the client-side person who signs in).
  portalEnabled     Boolean   @default(false) @map("portal_enabled")
  portalPasswordHash String?  @map("portal_password_hash")
  portalLastLoginAt DateTime? @map("portal_last_login_at") @db.Timestamptz(6)
  portalCanProjects Boolean   @default(true) @map("portal_can_projects")
  portalCanInvoices Boolean   @default(true) @map("portal_can_invoices")
  portalCanTickets  Boolean   @default(true) @map("portal_can_tickets")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@index([email])
  @@map("contacts")
}

// ─────────────────────────── Notifications & Activity ───────────────────────────

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @default("info")
  title          String
  body           String?
  link           String?
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
